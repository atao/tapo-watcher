# Copy to tapo.env, then: chmod 600 tapo.env

# Phones: comma-separated "ip=mac" list.
# One phone is enough to count as "home".
# Phones are identified by MAC: the IP is only a hint and is re-resolved from
# the MAC if it changes. It can be omitted ("=mac"), but a static IP
# (Pi-hole static lease) avoids a subnet ping sweep.
# iPhone: Settings > Wi-Fi > (i) > Private Wi-Fi Address = Off or Fixed.
PHONES=192.168.1.50=aa:bb:cc:dd:ee:01,=aa:bb:cc:dd:ee:02

# Tapo C210 camera
CAMERA_IP=192.168.1.100
# Camera account created in the Tapo app: Camera > Settings > Advanced > Camera Account
# (or "admin" + TP-Link cloud account password)
CAMERA_USER=camera_user
# Wrap in single quotes if the password contains "$"
CAMERA_PASSWORD='change-me'

# Actions: preset:<name|id>  move:<x>,<y>  privacy:on|off  none
# Presets are created in the Tapo app (Pan/Tilt > Saved positions)
ACTION_HOME=preset:Home
ACTION_AWAY=preset:Away

# Seconds between two checks
INTERVAL=30
# Number of failed checks before a phone counts as away
# (6 x 30s = 3 min, avoids false departures while the phone is asleep)
AWAY_AFTER_MISSES=6

# Adaptive away delay: learns how long each phone stays silent while asleep
# at home, and waits that long (95th percentile x ADAPTIVE_MARGIN) before
# declaring it away. Until ADAPTIVE_MIN_SAMPLES silences are learned,
# AWAY_AFTER_MISSES x INTERVAL is used. See: uv run tapo_watcher.py --stats
ADAPTIVE_DELAY=1
# Bounds of the away delay, in seconds. Silences longer than AWAY_MAX are
# real absences and are not learned.
AWAY_MIN=60
AWAY_MAX=1200
ADAPTIVE_MARGIN=1.2
ADAPTIVE_MIN_SAMPLES=5
